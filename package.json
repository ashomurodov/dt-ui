{
  "name": "aetherx-dt-ui",
  "version": "0.1.66",
  "description": "Lightweight, customizable Vue components for DT projects",
  "type": "module",
  "bin": {
    "dt-ui": "dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "src/registry"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "reka-ui": "^2.9.6",
    "typescript": "^5.7.0",
    "unbuild": "^3.3.1",
    "vitepress": "^1.6.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.6"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "6.4.2"
  },
  "keywords": [
    "vue",
    "components",
    "ui",
    "design-system",
    "dt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashomurodov/dt-ui.git"
  },
  "homepage": "https://github.com/ashomurodov/dt-ui#readme",
  "bugs": {
    "url": "https://github.com/ashomurodov/dt-ui/issues"
  }
}
